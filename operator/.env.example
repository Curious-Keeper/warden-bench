# =============================================================================
# Warden harness — environment template
# =============================================================================
# Copy to `.env` and fill in the required values. Every variable below has a
# documented default, so commented-out lines mean "use the default". The same
# .env is read by:
#   - warden-operator.ipynb        (PAIR + cross-pass loop + blind mode)
#   - tap/tap.py                   (Tree of Attacks with Pruning)
#   - gap/gap.py                   (Graph of Attacks with Pruning)
#   - crescendo/crescendo.py       (multi-turn benign-to-escalation)
# =============================================================================

# ---- Required ---------------------------------------------------------------
# ANTHROPIC_API_KEY drives the attacker + judge LLMs (Sonnet 4.6 by default).
# WARDEN_BASE points at the lab; default is the public prod URL.
# WARDEN_PASSCODE is the CF-Access cookie for prod. Leave UNSET when running
#   against a local Docker instance — the local FastAPI origin fails open
#   when GATE_AUTH_SECRET is unset, so no cookie is needed.

ANTHROPIC_API_KEY=sk-ant-...
# WARDEN_BASE=https://warden.scalingsuccess.io
# WARDEN_PASSCODE=<current passcode>


# ---- Shared tuning (notebook + TAP + GAP + Crescendo) -----------------------

# WARDEN_ATTACKER_MODEL  default: claude-sonnet-4-6
#   Attacker + judge LLM. Bump to claude-opus-4-7 for harder L7/L8 runs;
#   drop to claude-haiku-4-5 for cheap batch sweeps.
# WARDEN_ATTACKER_MODEL=claude-sonnet-4-6

# WARDEN_SLEEP  default: 3.5
#   Seconds between target chat calls. Lab rate-limits to 20/min, so 3.0
#   is the floor. Lower values trip 429s and burn ~5 minutes recovering.
# WARDEN_SLEEP=3.5


# ---- PAIR / notebook only ---------------------------------------------------

# WARDEN_ATTEMPTS  default: 3
#   Max attacker-generated prompts per level before declaring a fail.
# WARDEN_ATTEMPTS=10

# WARDEN_LOOP_TURNS  default: 3
#   Default `turns` for run_loop(). Each pass auto-verifies known solves
#   and only re-attacks unsolved levels.
# WARDEN_LOOP_TURNS=3

# WARDEN_CORPUS_K  default: unset (use all available, capped at WARDEN_ATTEMPTS)
#   Max corpus prompts to replay per level per run. Set to 0 to disable
#   corpus warm-start; set to a small N (e.g. 3) to cap replay cost.
# WARDEN_CORPUS_K=3

# WARDEN_BLIND  default: 0
#   Set to 1 to enable blind mode. Runs the fingerprint phase before
#   attacks on each unsolved level (pass 1 only).
# WARDEN_BLIND=1

# WARDEN_PARSELTONGUE  default: unset
#   Apply input obfuscation to every attacker prompt. Helps against
#   moderation; HURTS persona refusals (don't enable globally).
#   Techniques: leetspeak | unicode | zwj | mixedcase | phonetic | random
# WARDEN_PARSELTONGUE=leetspeak


# ---- TAP (operator/tap/) -------------------------------------------

# TAP_BRANCH  default: 3      Children per node
# TAP_WIDTH   default: 2      Survivors per layer
# TAP_DEPTH   default: 3      Max layers
# TAP_BRANCH=3
# TAP_WIDTH=2
# TAP_DEPTH=3


# ---- GAP (operator/gap/) -------------------------------------------

# GAP_BRANCH      default: 3   Children per node
# GAP_WIDTH       default: 2   Survivors per layer
# GAP_DEPTH       default: 3   Max layers
# GAP_MEMORY_CAP  default: 12  Max nodes kept in shared StrategyMemory.
#   Larger = more cross-branch context, but the attacker user message
#   grows with it; cap exists so deep trees don't blow past prompt cache.
# GAP_BRANCH=3
# GAP_WIDTH=2
# GAP_DEPTH=3
# GAP_MEMORY_CAP=12


# ---- Crescendo (operator/crescendo/) -------------------------------

# CRESCENDO_TURNS       default: 5
#   Max turns per benign-to-escalation conversation. Bump to 7-8 for L8.
# CRESCENDO_EARLY_EXIT  default: 1
#   Stop the conversation when the judge has rejected 3+ candidates from
#   the same arc — further turns won't change the leak shape. Set to 0
#   when debugging why a specific arc stalls.
# CRESCENDO_TURNS=5
# CRESCENDO_EARLY_EXIT=1
