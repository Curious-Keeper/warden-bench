# Anthropic API key for the agent loop.
ANTHROPIC_API_KEY=sk-ant-...

# Browser service endpoint (default 127.0.0.1:8765).
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8765

# Headed (1, default) or headless (0) Playwright launch.
HARNESS_HEADED=1

# Default Claude model for the agent loop.
# Sonnet 4.6 = cheap, capable. Opus 4.7 = harder targets, ~5x cost.
HARNESS_MODEL=claude-sonnet-4-6

# Where to persist storage_state.json (cookies + localStorage).
# Relative to harness/ root. Override per-target if needed.
HARNESS_SESSION_DIR=.session

# --- Target-specific overrides (read by target adapters) ---

# warden test target
WARDEN_BASE=http://127.0.0.1:8000


# Optional: TTS for audio-channel uploads .
# Leave unset to use local piper if installed.
ELEVENLABS_API_KEY=
